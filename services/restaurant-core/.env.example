APP_NAME="Restaurant Core"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8000
APP_VERSION=0.1.0

APP_LOCALE=es
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

# "daily" rotates storage/logs/laravel-*.log and prunes old files automatically.
LOG_CHANNEL=daily
LOG_STACK=single
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

# Restaurant Core is PostgreSQL-only. Never switch this to sqlite/mysql in production.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=restaurant_core
DB_USERNAME=restaurant_core
DB_PASSWORD=

# Public URL encoded in physical table QR codes. Override per deployment.
TABLE_QR_PUBLIC_BASE_URL=http://127.0.0.1:8000/t

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=sync

CACHE_STORE=file

MAIL_MAILER=log

# Host/port Restaurant Core binds to. 0.0.0.0 in production so LAN devices
# (waiter tablets, kitchen displays) can reach it; see docs/development.md.
CORE_HOST=127.0.0.1
CORE_PORT=8000
MOBILE_CORE_URL=http://192.168.1.10:8000
RESTAURANT_NAME=Restaurant Admin

# Comma-separated list of origins allowed to call the API (Admin Desktop's
# Tauri webview origins). Never use "*" here.
CORS_ALLOWED_ORIGINS=tauri://localhost,http://tauri.localhost,http://localhost:1420

# TCP targets used for the short-timeout internet reachability probe.
# Never treat their failure as a critical/application error.
INTERNET_CHECK_HOSTS=1.1.1.1:53,8.8.8.8:53
INTERNET_CHECK_TIMEOUT=1.5
