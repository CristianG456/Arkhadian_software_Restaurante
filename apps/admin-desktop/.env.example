# Copy to .env to override — every value already has a sane local default
# in src/config/env.ts, so this file is optional in development.

# Restaurant Core's REST API base URL.
VITE_CORE_BASE_URL=http://127.0.0.1:8000

# How often the status screen re-polls Core, in milliseconds.
VITE_STATUS_POLL_INTERVAL_MS=5000

# Per-request timeout before a call to Core is treated as unreachable.
VITE_CORE_REQUEST_TIMEOUT_MS=3000
